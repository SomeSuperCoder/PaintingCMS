# ── Database ────────────────────────────────────────────────
# Credentials for the postgres:16 container (also used by compose `api` → `db`)
POSTGRES_USER=paintingcms
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=paintingcms

# ── Connection strings ──────────────────────────────────────
# Local dev (bare-metal `just dev`): Postgres published on localhost:5432
DATABASE_URL=postgresql://paintingcms:change-me-strong@localhost:5432/paintingcms
# In-container (compose `api` service): "db" is the compose service name
DATABASE_URL_PROD=postgresql://paintingcms:change-me-strong@db:5432/paintingcms

# ── Telegram Mini App ───────────────────────────────────────
# Bot token from BotFather (test token for dev/E2E; real token for prod)
# REQUIRED — it is the HMAC secret for initData validation; the API fails at
# boot without it (env.validation.ts).
BOT_TOKEN=
# Public URL of the Mini App (https in prod; BotFather /setdomain)
WEBAPP_URL=
# Max age of validated initData, seconds (D2)
INIT_DATA_MAX_AGE_SECONDS=600

# ── API / runtime ───────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Caddy (podman-compose) ──────────────────────────────────
# Public domain for auto-TLS (localhost for local dev; needs DNS → host in prod)
CADDY_DOMAIN=localhost

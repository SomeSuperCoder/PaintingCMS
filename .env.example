# PaintingCMS environment — THE single source of truth.
# -----------------------------------------------------------------------------
# Copy to `.env` and fill in:   cp .env.example .env
#
# `.env` is read by:
#   - `just` (local dev recipes)          — via dotenv-load
#   - podman-compose (the prod stack)     — automatically, for `${...}` + env_file
# The API itself also reads `.env` at the repo root for bare-metal dev.
#
# Do NOT commit `.env`. Do NOT duplicate these values anywhere else.
# -----------------------------------------------------------------------------

# ── Public origin ────────────────────────────────────────────────────────────
# The one URL for the whole app. It drives ALL of:
#   - Caddy's TLS domain (`caddy reverse-proxy --from $PUBLIC_URL`)
#   - the API's CORS allow-list (production)
#   - the Telegram webhook base URL
#   - the bot's "Open catalog" Mini App button
# MUST be `https://<domain>` in production, and DNS must point at the host so
# Caddy can issue a Let's Encrypt cert (ports 80 + 443 open).
# For a local `just up` smoke test use: http://localhost (Caddy binds :80, so
# that needs rootful podman — see README "Deploy").
PUBLIC_URL=https://painting.example.com

# ── Postgres ─────────────────────────────────────────────────────────────────
# Used by the `db` container AND to derive DATABASE_URL (localhost for bare-metal
# dev, `db` inside compose) — there is no DATABASE_URL to set by hand.
#
# ⚠ SET POSTGRES_PASSWORD BEFORE THE FIRST `just up`.
# Postgres only reads it when it creates the data volume; changing it afterwards
# silently breaks auth. If you must change it later: `just backup` then
# `just db-reset` (DESTROYS local data), or restore the old value.
# Use a URL-safe password (letters/digits/-_.~), no @ : / # ? & characters.
POSTGRES_USER=paintingcms
POSTGRES_PASSWORD=
POSTGRES_DB=paintingcms

# ── Telegram Mini App ────────────────────────────────────────────────────────
# Bot token from BotFather. REQUIRED in production: it is the HMAC secret for
# every initData validation, and the API refuses to boot without it.
BOT_TOKEN=

# Optional tuning:
# DEV_MODE=false                     # true = skip HMAC + dummy bot (NEVER in prod)
# INIT_DATA_MAX_AGE_SECONDS=600      # max age of validated initData

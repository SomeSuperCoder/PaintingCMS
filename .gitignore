# ── dependencies ──────────────────────────────────────────
node_modules/

# ── environment & secrets (never commit) ─────────────────
.env
.env.*
!.env.example

# ── build output ──────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ── local data & storage ─────────────────────────────────
data/
storage/
backups/

# Last commit shipped by `just deploy` — lets a no-op deploy skip the image
# build. Untracked local state; MUST stay ignored or its presence dirties
# `git status --porcelain`, which the deploy skip-check relies on.
.deploy-stamp

# ── test artifacts ────────────────────────────────────────
playwright-report/
test-results/
blob-report/
coverage/

# ── tooling & editor ─────────────────────────────────────
.codegraph/
*.log
.DS_Store
.idea/
.vscode/

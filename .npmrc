# pnpm v10+ blocks dependency build scripts by default (security-by-default).
# The allow/deny list lives in pnpm-workspace.yaml under `allowBuilds`
# (esbuild: true, playwright: false). `.npmrc` stays lean on purpose.
#
# When new deps with postinstall scripts appear, run `pnpm approve-builds`
# and review what gets enabled — never blanket-enable all scripts.
strict-peer-dependencies=false
